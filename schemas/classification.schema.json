{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grimperoots.fr/schemas/article-tag-classification.json",
  "title": "Grimperoots article tag classification",
  "description": "Structured output for a human-reviewed article tagging proposal.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "article_id",
    "suggested_tags",
    "uncertain_tags"
  ],
  "properties": {
    "article_id": {
      "type": "integer",
      "minimum": 1
    },
    "suggested_tags": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/confidentTag"
      }
    },
    "uncertain_tags": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/uncertainTag"
      }
    }
  },
  "$defs": {
    "confidentTag": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "confidence"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "uncertainTag": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "confidence",
        "reason"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
