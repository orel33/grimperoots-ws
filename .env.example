# API Joomla standarde — exports et application des tags
JOOMLA_BASE_URL=https://www.example.org/j6
JOOMLA_TOKEN=remplacer-par-le-token-joomla

# Endpoints personnalisés dans /www/ws/
SITE_URL=https://www.example.org/j6
GRIMPEROOTS_WS_TOKEN=remplacer-par-un-secret-aleatoire

# Déploiement FTP des endpoints versionnés vers /www/ws/
FTP_HOST=ftp.example.org
FTP_USER=utilisateur
FTP_PASSWORD=mot-de-passe
FTP_PLAIN=false
REMOTE_ROOT=/www/j6
